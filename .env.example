# Biến môi trường — BẢN MẪU. Copy thành `.env` rồi điền giá trị thật.
#
#   cp .env.example .env
#
# Trả lời câu hỏi: cần biến nào để chạy được dự án này?
# Trạng thái:     🟢 đủ — khớp code tại 2026-10-04
# Cập nhật khi:    code đọc một biến mới (process.env.X / os.getenv / os.Getenv / ...)
#
# HAI QUY TẮC
#   1. File này KHÔNG chứa giá trị thật. Chỉ tên biến + cách lấy giá trị.
#      `.env` là bản thật và đã bị .gitignore — giữ nguyên như vậy.
#   2. Danh sách này phải khớp CODE, không khớp tài liệu thiết kế. Biến nào code
#      không còn đọc thì xoá; biến nào code đọc mà thiếu ở đây là một cái bẫy.
#
# Mỗi biến ghi 3 thứ: ai đọc nó · bắt buộc khi nào · lấy giá trị ở đâu

# ─────────────────────────────────────────────────────────────
# Bắt buộc
# ─────────────────────────────────────────────────────────────

# Không có. Game chạy hoàn toàn phía client, không có server, không có datastore,
# không có khoá API nào. `pnpm dev` chạy được ngay sau `pnpm install`.

# ─────────────────────────────────────────────────────────────
# Đường dẫn gốc và đăng nhập Ducker ID
# ─────────────────────────────────────────────────────────────
#
# Mọi biến NEXT_PUBLIC_* đều CÔNG KHAI — Next inline chúng vào bundle lúc build.
# Đừng bao giờ đặt bí mật ở đây. Code KHÔNG có giá trị mặc định cho các biến này:
# thiếu một biến thì tính năng tắt, game chạy như cũ.

# đọc bởi:  next.config.ts, src/lib/duckerConfig.ts (redirect_uri)
# ý nghĩa:  đường dẫn con khi deploy. Local để TRỐNG (= gốc). GitHub Pages phục vụ
#           trang ở "/web-game-duck-push" — CHỈ workflow deploy đặt giá trị đó
#           (không có "/" ở cuối). Đặt nó ở máy sẽ làm `pnpm dev` hỏng đường dẫn tài nguyên.
NEXT_PUBLIC_BASE_PATH=

# Đăng nhập Ducker ID (OIDC Authorization Code + PKCE, public client, không có client_secret).
# Đang "ship tối": deploy.yml KHÔNG truyền cờ và các biến DUCKER_*, nên bản trên
# GitHub Pages không có nút. Chỉ bật ở máy khi thử.

# Cờ bật tính năng — chỉ đúng chuỗi "true" mới bật. Local: true.
NEXT_PUBLIC_FEATURE_DUCKER_SIGN_IN=
# Gốc của Ducker ID (nơi có /oauth/authorize, /oauth/token, /oauth/userinfo). Local: http://localhost:3000
NEXT_PUBLIC_DUCKER_ISSUER=
# client_id của game này, đăng ký trong admin console của Ducker ID.
NEXT_PUBLIC_DUCKER_CLIENT_ID=
# Scope xin khi đăng nhập — phải nằm trong allowed scopes của client. Local: openid profile email
NEXT_PUBLIC_DUCKER_SCOPE=
# Trang hồ sơ trên Ducker ID (tương đối với ISSUER). Local: /profile
NEXT_PUBLIC_DUCKER_PROFILE_PATH=

# Cần đăng ký bên Ducker ID:
#   - redirect URI (khớp TUYỆT ĐỐI): local  http://localhost:3427/
#                                    deploy https://levananhduc.github.io/web-game-duck-push/
#   - thêm http://localhost:3427 vào CORS_ORIGINS của Ducker ID server
#     (trình duyệt gọi /oauth/token và /oauth/userinfo trực tiếp).

# ─────────────────────────────────────────────────────────────
# Chỉ dùng khi chạy test
# ─────────────────────────────────────────────────────────────

# Không có. Unit test chạy trong happy-dom, e2e chạy trên bản build tĩnh.
