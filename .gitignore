
# Bí mật — `.env.example` là bản mẫu và ĐƯỢC commit; `.env` là bản thật và không bao giờ commit.
.env
.env.*
!.env.example

# Toolchain — the app lives in client/, the regression suite in automation-testing/
node_modules/
.next/
/client/out/
/client/next-env.d.ts
*.tsbuildinfo

# Playwright (automation-testing/ and any local MCP session)
test-results/
playwright-report/
blob-report/
playwright/.cache/
.auth/
.playwright-mcp/

# Worktree cua feature — dat trong repo theo quy uoc workspace
.worktrees/

# --- Claude Code: theo doi config + skills, bo qua worktrees/doc-state ---
/.claude/*
!/.claude/CLAUDE.md
!/.claude/settings.local.json
!/.claude/skills/
!/.claude/scripts/
!/.claude/agents/

# e2e: hai bản build tĩnh (cờ tắt / cờ bật) mà automation-testing/ phục vụ
/client/.e2e/
