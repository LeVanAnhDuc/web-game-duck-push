{
  "name": "web-game-duck-push",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "node scripts/e2e-serve.mjs --build",
    "levels:generate": "tsx scripts/generate-pack.ts",
    "release:next": "pnpm dlx git-cliff@2.13.1 --workdir .. --bumped-version",
    "release:notes": "pnpm dlx git-cliff@2.13.1 --workdir .. --unreleased --tag $(pnpm dlx git-cliff@2.13.1 --workdir .. --bumped-version) --strip all"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "happy-dom": "^20.13.2",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "serve": "^14.2.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.20": "^1.1.20",
      "brace-expansion@>=4.0.0 <5.0.11": "^5.0.11",
      "compression@<1.8.2": "^1.8.2",
      "sharp@<0.35.5": "^0.35.5",
      "source-map-js@<1.2.2": "^1.2.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
